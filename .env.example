# Copy to .env and adjust. Real secrets never belong in the repository.

# SQLite is fine for early local development; the real target is PostgreSQL.
DATABASE_URL=sqlite:///./movie_recs.db
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/movie_recs

# Use a long random value in any real deployment.
JWT_SECRET=dev-only-insecure-secret-change-me

# Where prepare_data.py / train_and_precompute.py wrote their artifacts.
PROCESSED_DIR=data/processed

CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
