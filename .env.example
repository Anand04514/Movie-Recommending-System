# Copy to .env and adjust. Real secrets never belong in the repository.

# SQLite is fine for early local development; the real target is PostgreSQL.
DATABASE_URL=sqlite:///./movie_recs.db
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/movie_recs

# Use a long random value in any real deployment.
JWT_SECRET=dev-only-insecure-secret-change-me

# Where prepare_data.py / train_and_precompute.py wrote their artifacts.
PROCESSED_DIR=data/processed

# Precomputed candidates older than this are ignored, so a cache cannot serve forever.
PRECOMPUTE_TTL_MINUTES=360

# Recency (5.12): how many years count as "new", and the size of the re-ranking bonus.
# The bonus is added when ordering candidates; the reported score is never rewritten.
NEW_RELEASE_YEARS=2
NEW_RELEASE_BOOST=0.15

CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# --- Deployment ------------------------------------------------------------------------------
# Serve the built React app from the API's own origin: one container, one port, no CORS.
# SERVE_FRONTEND=1
# FRONTEND_DIST=frontend/dist
# Checksummed artifact bundle fetched at container start (see scripts/start.sh).
# ARTIFACTS_URL=https://example.com/artifacts.tar.gz
# ARTIFACTS_SHA256=
# Seed the catalog once on boot, and how many MovieLens demo users to mirror.
# SEED_ON_START=1
# DEMO_USERS=120

# TMDB (optional): posters, overviews, search beyond the dataset and on-demand ingestion.
# Either credential enables it; with neither, the app renders without posters, search returns the
# catalog only, and /api/movies/tmdb/{id} answers 503. The v4 read access token is preferred.
TMDB_READ_ACCESS_TOKEN=
# TMDB_API_KEY=
TMDB_POSTER_SIZE=w342
TMDB_CACHE_DIR=data/processed/tmdb_cache
# How long a TMDB search answer is reused. Results change slowly; a day is free accuracy.
TMDB_SEARCH_CACHE_MINUTES=1440
